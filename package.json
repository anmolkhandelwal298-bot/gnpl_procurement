{
  "name": "grainspan-procurement",
  "version": "1.0.0",
  "private": true,
  "description": "Grainspan Nutrients — live procurement & reverse auction portal",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:start": "scripts/dev-db.sh start",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/migrate.ts --reset && tsx scripts/seed.ts",
    "test": "vitest run",
    "test:db": "vitest run tests/db",
    "test:e2e": "tsx tests/e2e/realtime-auction.e2e.ts"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "luxon": "3.7.2",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/luxon": "3.7.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "1.63.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
