# ---- Database (PostgreSQL 15+; Supabase Postgres works) ----
# Runtime connection: the restricted, RLS-bound role created by the migrations. NEVER use a superuser / service-role URL here.
DATABASE_URL=postgres://grainspan_app:change-me@127.0.0.1:54329/grainspan
# Optional: direct (non-pooled) connection used for LISTEN/NOTIFY realtime. Required if DATABASE_URL points at a transaction pooler.
DATABASE_URL_LISTEN=
# Owner connection used ONLY by migrations / seed scripts (never by the running app).
MIGRATION_DATABASE_URL=postgres://postgres@127.0.0.1:54329/grainspan
# Password that `npm run db:migrate` assigns to the grainspan_app role.
APP_DB_PASSWORD=change-me

# ---- App ----
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Kolkata
# 32+ random bytes, hex or base64: openssl rand -hex 32
SESSION_SECRET=
# Bearer secret for /api/cron/tick (external scheduler; the in-process scheduler runs regardless)
CRON_SECRET=
# Set to "true" only behind HTTPS (production). Controls the Secure cookie flag + HSTS.
COOKIE_SECURE=false
# Run the in-process scheduler (auction open/close, reminders, notification retries). Keep true on a single long-running instance.
RUN_SCHEDULER=true
# Banner shown on all pages when demo data exists
SHOW_DEMO_BANNER=true

# ---- Email (Resend) ----
RESEND_API_KEY=
EMAIL_FROM=Grainspan Procurement <procurement@your-verified-domain.com>
RESEND_WEBHOOK_SECRET=

# ---- WhatsApp Business Platform (Meta Cloud API) ----
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=en
# Approved template names (see docs/NOTIFICATIONS.md for the exact body text to submit for approval)
WHATSAPP_TEMPLATE_RFQ_INVITATION=gnpl_rfq_invitation
WHATSAPP_TEMPLATE_QUOTATION_REMINDER=gnpl_quotation_reminder
WHATSAPP_TEMPLATE_AUCTION_OPEN=gnpl_auction_open
WHATSAPP_TEMPLATE_AUCTION_CLOSING=gnpl_auction_closing
WHATSAPP_TEMPLATE_AUCTION_CLOSED=gnpl_auction_closed
WHATSAPP_TEMPLATE_AWARD=gnpl_award
WHATSAPP_TEMPLATE_NON_AWARD=gnpl_non_award

# ---- Advanced / testing (leave unset in production) ----
# Minimum seconds between now and a quotation deadline / auction start (default 60)
# AUCTION_MIN_LEAD_SECONDS=60
# Override provider endpoints (used by the automated tests to point the real client code at a local mock server)
# RESEND_API_BASE=https://api.resend.com
# WHATSAPP_API_BASE=https://graph.facebook.com
# SCHEDULER_INTERVAL_MS=2000
# SESSION_IDLE_MINUTES=60
# SESSION_ABSOLUTE_HOURS=12
# DATABASE_SSL=true|no-verify   (needed for most hosted Postgres incl. Supabase)
